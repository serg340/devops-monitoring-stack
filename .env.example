# Copy this file to .env and replace every placeholder with a strong unique value.
MYSQL_DATABASE=sto_prod
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# MySQL Exporter DSN. Create a dedicated MySQL user with the required monitoring grants.
MYSQL_EXPORTER_DATA_SOURCE_NAME=exporter:CHANGE_ME@tcp(mysql:3306)/
